{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    {
      "source": "/proxy/signzy-v3/:path*",
      "destination": "https://api-preproduction.signzy.app/api/v3/:path*"
    },
    {
      "source": "/proxy/signzy-v2/:path*",
      "destination": "https://api-preproduction.signzy.app/api/v2/patrons/:path*"
    },
    {
      "source": "/proxy/signzy-otp/:path*",
      "destination": "https://api-preproduction.signzy.us/api/v3/:path*"
    },
    {
      "source": "/proxy/ckyc/:path*",
      "destination": "https://ckyc.finz.finance/api/:path*"
    },
    {
      "source": "/proxy/ckyc-uat/:path*",
      "destination": "https://ckycdev.finz.finance/api/:path*"
    },
    {
      "source": "/proxy/mtalkz",
      "destination": "https://msgn.mtalkz.com/api"
    },
    {
      "source": "/proxy/mtalkz/:path*",
      "destination": "https://msgn.mtalkz.com/api/:path*"
    },
    {
      "source": "/proxy/digitap/:path*",
      "destination": "https://svc.digitap.ai/:path*"
    },
    { "source": "/((?!proxy/|assets/|_expo/|favicon|.*\\..*).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
